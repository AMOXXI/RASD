<Window x:Class="RASD_AdminWatcher.SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RASD â€” Preflight Check"
        Width="520" Height="460"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        Topmost="True">
    <Border Background="{StaticResource BrushSurface}"
            BorderBrush="{StaticResource BrushBorder}"
            BorderThickness="1"
            CornerRadius="6">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- DRAG HANDLE -->
            <Border Grid.Row="0" Background="Transparent" MouseLeftButtonDown="Border_MouseLeftButtonDown"
                    Height="32" Cursor="SizeAll"/>

            <!-- CONTENT -->
            <StackPanel Grid.Row="1" Margin="48,0,48,0" VerticalAlignment="Center">

                <!-- Logo -->
                <StackPanel HorizontalAlignment="Center" Margin="0,0,0,32">
                    <Border Width="60" Height="60" CornerRadius="30"
                            HorizontalAlignment="Center"
                            RenderOptions.BitmapScalingMode="HighQuality">
                        <Border.Background>
                            <ImageBrush ImageSource="pack://application:,,,/rasd-logo.png" Stretch="UniformToFill"/>
                        </Border.Background>
                    </Border>
                    <TextBlock Text="RASD" FontFamily="Consolas" FontSize="22" FontWeight="Bold"
                               Foreground="{StaticResource BrushWhite}"
                               HorizontalAlignment="Center" Margin="0,10,0,0"/>
                    <TextBlock Text="ADMIN WATCHER â€” PREFLIGHT CHECK"
                               FontFamily="Consolas" FontSize="9"
                               Foreground="{StaticResource BrushDim}"
                               HorizontalAlignment="Center" Margin="0,4,0,0"/>
                </StackPanel>

                <!-- Step 1: PostgreSQL -->
                <Border x:Name="StepPg" CornerRadius="4" Margin="0,0,0,8"
                        Background="#08FFFFFF" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1">
                    <Grid Margin="16,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse x:Name="DotPg" Width="8" Height="8" Fill="{StaticResource BrushMuted}"/>
                            <TextBlock FontFamily="Consolas" FontSize="11" Foreground="{StaticResource BrushGhost}">
                                PostgreSQL Database  <Run Foreground="{StaticResource BrushMuted}">:5432</Run>
                            </TextBlock>
                        </StackPanel>
                        <TextBlock x:Name="LblPg" Grid.Column="1" FontFamily="Consolas" FontSize="10"
                                   Foreground="{StaticResource BrushMuted}" Text="WAITING..." VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <!-- Step 2: Node.js API -->
                <Border x:Name="StepApi" CornerRadius="4" Margin="0,0,0,8"
                        Background="#08FFFFFF" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1">
                    <Grid Margin="16,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse x:Name="DotApi" Width="8" Height="8" Fill="{StaticResource BrushMuted}"/>
                            <TextBlock FontFamily="Consolas" FontSize="11" Foreground="{StaticResource BrushGhost}">
                                RASD API Server  <Run Foreground="{StaticResource BrushMuted}">:3000</Run>
                            </TextBlock>
                        </StackPanel>
                        <TextBlock x:Name="LblApi" Grid.Column="1" FontFamily="Consolas" FontSize="10"
                                   Foreground="{StaticResource BrushMuted}" Text="WAITING..." VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <!-- Step 3: LAN IP -->
                <Border x:Name="StepIp" CornerRadius="4" Margin="0,0,0,8"
                        Background="#08FFFFFF" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1">
                    <Grid Margin="16,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse x:Name="DotIp" Width="8" Height="8" Fill="{StaticResource BrushMuted}"/>
                            <TextBlock FontFamily="Consolas" FontSize="11" Foreground="{StaticResource BrushGhost}">
                                LAN Network Interface
                            </TextBlock>
                        </StackPanel>
                        <TextBlock x:Name="LblIp" Grid.Column="1" FontFamily="Consolas" FontSize="10"
                                   Foreground="{StaticResource BrushMuted}" Text="DETECTING..." VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <!-- Status / Error message -->
                <TextBlock x:Name="TxtStatus" FontFamily="Consolas" FontSize="10"
                           Foreground="{StaticResource BrushDim}"
                           HorizontalAlignment="Center" Margin="0,16,0,0"
                           Text="Initializing..." TextWrapping="Wrap" TextAlignment="Center"/>

                <!-- Retry button (hidden by default) -->
                <Button x:Name="BtnRetry" Content="âں³  RETRY CONNECTION" Margin="0,16,0,0"
                        Style="{StaticResource AccentButton}" Visibility="Collapsed"
                        Click="BtnRetry_Click"/>
            </StackPanel>

            <!-- PROGRESS BAR -->
            <ProgressBar x:Name="PbSplash" Grid.Row="2" Height="2"
                         Background="{StaticResource BrushBorder}"
                         Foreground="{StaticResource BrushAccent}"
                         BorderThickness="0" IsIndeterminate="True"
                         Margin="0,0,0,0"/>
        </Grid>
    </Border>
</Window>


