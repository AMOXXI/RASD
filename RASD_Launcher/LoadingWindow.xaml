<Window x:Class="RASD_Launcher.LoadingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RASD" Height="400" Width="680"
        WindowStyle="None" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="Transparent" AllowsTransparency="True">

    <Window.Resources>
        <!-- Outlined teal RETRY button -->
        <Style x:Key="RetryBtn" TargetType="Button">
            <Setter Property="Foreground" Value="#00B4D8"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="#00B4D8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="24,7"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" CornerRadius="6"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#1500B4D8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- LEFT: brand panel -->
        <Border Grid.Column="0" CornerRadius="12,0,0,12">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#0D1B2A" Offset="0"/>
                    <GradientStop Color="#1B4332" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="24,0">
                <TextBlock Text="R.A.S.D" FontFamily="Segoe UI" FontSize="32" FontWeight="Bold"
                           Foreground="#FFFFFF" HorizontalAlignment="Center"/>
                <TextBlock Text="Remote Administration Security Dashboard"
                           FontFamily="Segoe UI" FontSize="11" Foreground="#C7CDD4"
                           TextAlignment="Center" TextWrapping="Wrap" MaxWidth="210" Margin="0,10,0,0"/>
                <TextBlock Text="Secure. Monitor. Control." FontFamily="Segoe UI" FontSize="10"
                           FontStyle="Italic" Foreground="#00B4D8"
                           HorizontalAlignment="Center" Margin="0,14,0,0"/>
                <Path Data="M22,2 L42,10 L42,26 C42,38 22,46 22,46 C22,46 2,38 2,26 L2,10 Z"
                      Stroke="#00B4D8" StrokeThickness="2" Fill="#1500B4D8"
                      Width="44" Height="48" Stretch="Uniform"
                      HorizontalAlignment="Center" Margin="0,24,0,0"/>
            </StackPanel>
        </Border>

        <!-- RIGHT: launcher status panel -->
        <Border Grid.Column="1" CornerRadius="0,12,12,0" Background="#0F1923">
            <Grid Margin="30,26,30,24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- title    -->
                    <RowDefinition Height="Auto"/> <!-- subtitle -->
                    <RowDefinition Height="Auto"/> <!-- card 1   -->
                    <RowDefinition Height="Auto"/> <!-- card 2   -->
                    <RowDefinition Height="Auto"/> <!-- card 3   -->
                    <RowDefinition Height="*"/>    <!-- spacer   -->
                    <RowDefinition Height="Auto"/> <!-- progress -->
                    <RowDefinition Height="Auto"/> <!-- status   -->
                    <RowDefinition Height="Auto"/> <!-- retry    -->
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="Initializing System..."
                           FontFamily="Segoe UI" FontSize="16" FontWeight="Bold" Foreground="#FFFFFF"/>
                <TextBlock Grid.Row="1" Text="Please wait while RASD starts up."
                           FontFamily="Segoe UI" FontSize="10" Foreground="#6B7280" Margin="0,4,0,16"/>

                <!-- Card 1: RASD Connector -->
                <Border Grid.Row="2" Background="#1A2535" BorderBrush="#2A3545" BorderThickness="1"
                        CornerRadius="8" Padding="14,10" Margin="0,0,0,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Ellipse x:Name="Dot1" Width="9" Height="9" Fill="#2D3748" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="RASD Connector" FontFamily="Segoe UI" FontSize="12"
                                       FontWeight="Bold" Foreground="#FFFFFF"/>
                            <TextBlock Text="Node.js API Server" FontFamily="Segoe UI" FontSize="9"
                                       Foreground="#6B7280" Margin="0,2,0,0"/>
                        </StackPanel>
                        <TextBlock Grid.Column="2" x:Name="Status1" Text="Waiting"
                                   FontFamily="Segoe UI" FontSize="10" Foreground="#6B7280"
                                   VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <!-- Card 2: RASD Relay Engine -->
                <Border Grid.Row="3" Background="#1A2535" BorderBrush="#2A3545" BorderThickness="1"
                        CornerRadius="8" Padding="14,10" Margin="0,0,0,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Ellipse x:Name="Dot2" Width="9" Height="9" Fill="#2D3748" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="RASD Relay Engine" FontFamily="Segoe UI" FontSize="12"
                                       FontWeight="Bold" Foreground="#FFFFFF"/>
                            <TextBlock Text="WebSocket + TCP Bridge" FontFamily="Segoe UI" FontSize="9"
                                       Foreground="#6B7280" Margin="0,2,0,0"/>
                        </StackPanel>
                        <TextBlock Grid.Column="2" x:Name="Status2" Text="Waiting"
                                   FontFamily="Segoe UI" FontSize="10" Foreground="#6B7280"
                                   VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <!-- Card 3: RASD Dashboard -->
                <Border Grid.Row="4" Background="#1A2535" BorderBrush="#2A3545" BorderThickness="1"
                        CornerRadius="8" Padding="14,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Ellipse x:Name="Dot3" Width="9" Height="9" Fill="#2D3748" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="RASD Dashboard" FontFamily="Segoe UI" FontSize="12"
                                       FontWeight="Bold" Foreground="#FFFFFF"/>
                            <TextBlock Text="Web Control Center" FontFamily="Segoe UI" FontSize="9"
                                       Foreground="#6B7280" Margin="0,2,0,0"/>
                        </StackPanel>
                        <TextBlock Grid.Column="2" x:Name="Status3" Text="Waiting"
                                   FontFamily="Segoe UI" FontSize="10" Foreground="#6B7280"
                                   VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <!-- Progress bar -->
                <ProgressBar Grid.Row="6" x:Name="PbMain" Height="4"
                             Minimum="0" Maximum="100" Value="0"
                             Background="#1A2535" Foreground="#00B4D8" BorderThickness="0"/>

                <!-- Status message -->
                <TextBlock Grid.Row="7" x:Name="TxtStatus" Text="Initializing..."
                           FontFamily="Segoe UI" FontSize="10" Foreground="#9CA3AF"
                           HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"
                           Margin="0,12,0,0"/>

                <!-- Retry (hidden by default) -->
                <Button Grid.Row="8" x:Name="BtnRetry" Content="RETRY"
                        Style="{StaticResource RetryBtn}" Visibility="Collapsed"
                        Click="BtnRetry_Click" HorizontalAlignment="Center" Margin="0,14,0,0"/>
            </Grid>
        </Border>
    </Grid>
</Window>
