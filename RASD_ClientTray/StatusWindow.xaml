<Window x:Class="RASD_ClientTray.StatusWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RASD Endpoint Status"
        Width="420" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" WindowStartupLocation="CenterScreen"
        ShowInTaskbar="True">

    <Border Background="{StaticResource BrushVoid}" BorderBrush="{StaticResource BrushBorder}"
            BorderThickness="1" CornerRadius="10">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Title bar -->
            <Border Grid.Row="0" Background="{StaticResource BrushPanel}"
                    BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,0,0,1"
                    CornerRadius="10,10,0,0" Padding="16,10"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="8" Height="8" CornerRadius="4" Margin="0,0,10,0"
                                x:Name="DotTitle" Background="{StaticResource BrushMuted}"/>
                        <TextBlock Text="RASD ENDPOINT" FontFamily="Consolas" FontSize="12"
                                   FontWeight="Bold" Foreground="{StaticResource BrushWhite}"/>
                    </StackPanel>
                    <Button Content="✕" HorizontalAlignment="Right" Width="26" Height="20"
                            Background="Transparent" BorderThickness="0" Cursor="Hand"
                            Foreground="{StaticResource BrushDim}" FontSize="11"
                            Click="BtnHide_Click" ToolTip="Hide to notification area"/>
                </Grid>
            </Border>

            <!-- Status body -->
            <StackPanel Grid.Row="1" Margin="18,16,18,8">

                <!-- Big status line -->
                <Border x:Name="StatusCard" Background="#12233F" BorderBrush="{StaticResource BrushBorder}"
                        BorderThickness="1" CornerRadius="6" Padding="14,12" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="CONNECTION STATUS" FontFamily="Consolas" FontSize="9"
                                   Foreground="{StaticResource BrushMuted}" Margin="0,0,0,6"/>
                        <StackPanel Orientation="Horizontal">
                            <Border x:Name="DotStatus" Width="10" Height="10" CornerRadius="5"
                                    Margin="0,0,10,0" VerticalAlignment="Center"
                                    Background="{StaticResource BrushMuted}"/>
                            <TextBlock x:Name="TxtStatus" Text="Checking..." FontFamily="Consolas"
                                       FontSize="17" FontWeight="Bold"
                                       Foreground="{StaticResource BrushWhite}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Detail rows -->
                <Grid Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="130"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="ADMIN SERVER" FontFamily="Consolas"
                               FontSize="10" Foreground="{StaticResource BrushMuted}" Margin="0,0,0,9"/>
                    <TextBlock Grid.Row="0" Grid.Column="1" x:Name="TxtAdminIp" Text="—"
                               FontFamily="Consolas" FontSize="11"
                               Foreground="{StaticResource BrushTeal}" Margin="0,0,0,9"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="LAST HEARTBEAT" FontFamily="Consolas"
                               FontSize="10" Foreground="{StaticResource BrushMuted}" Margin="0,0,0,9"/>
                    <TextBlock Grid.Row="1" Grid.Column="1" x:Name="TxtHeartbeat" Text="—"
                               FontFamily="Consolas" FontSize="11"
                               Foreground="{StaticResource BrushDim}" Margin="0,0,0,9"/>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="WIRED ADAPTER" FontFamily="Consolas"
                               FontSize="10" Foreground="{StaticResource BrushMuted}" Margin="0,0,0,9"/>
                    <TextBlock Grid.Row="2" Grid.Column="1" x:Name="TxtAdapter" Text="—"
                               FontFamily="Consolas" FontSize="11"
                               Foreground="{StaticResource BrushDim}" Margin="0,0,0,9"/>

                    <TextBlock Grid.Row="3" Grid.Column="0" Text="THIS MACHINE" FontFamily="Consolas"
                               FontSize="10" Foreground="{StaticResource BrushMuted}" Margin="0,0,0,9"/>
                    <TextBlock Grid.Row="3" Grid.Column="1" x:Name="TxtHostname" Text="—"
                               FontFamily="Consolas" FontSize="11"
                               Foreground="{StaticResource BrushDim}" Margin="0,0,0,9"/>
                </Grid>

                <!-- Wired-connection-required notice (Phase 3) -->
                <Border x:Name="WiredNotice" Visibility="Collapsed"
                        Background="#3A1E00" BorderBrush="#F59E0B" BorderThickness="1"
                        CornerRadius="4" Padding="10,8" Margin="0,4,0,0">
                    <StackPanel>
                        <TextBlock x:Name="TxtWiredTitle" Text="WIRED CONNECTION REQUIRED"
                                   FontFamily="Consolas" FontSize="11" FontWeight="Bold" Foreground="#FDBA74"/>
                        <TextBlock x:Name="TxtWiredBody" TextWrapping="Wrap" FontFamily="Consolas" FontSize="9"
                                   Foreground="#FED7AA" Margin="0,3,0,0"
                                   Text="RASD only operates over a wired Ethernet connection. Please connect this machine to the network with an Ethernet cable."/>
                    </StackPanel>
                </Border>

                <!-- Read-only notice -->
                <Border Background="#0A14B89A" BorderBrush="#3014B89A" BorderThickness="1"
                        CornerRadius="4" Padding="10,7" Margin="0,4,0,0">
                    <TextBlock TextWrapping="Wrap" FontFamily="Consolas" FontSize="9"
                               Foreground="{StaticResource BrushDim}"
                               Text="This is a read-only status view. Security policy is managed by your administrator."/>
                </Border>
            </StackPanel>

            <!-- Actions -->
            <Border Grid.Row="2" Background="{StaticResource BrushPanel}"
                    BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,1,0,0"
                    CornerRadius="0,0,10,10" Padding="18,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" x:Name="BtnLog" Content="OPEN CONNECTOR LOG"
                            Style="{StaticResource GhostButton}" HorizontalAlignment="Left"
                            Click="BtnLog_Click"/>
                    <Button Grid.Column="1" x:Name="BtnReconnect" Content="RECONNECT NOW"
                            Style="{StaticResource TealButton}" Click="BtnReconnect_Click"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
